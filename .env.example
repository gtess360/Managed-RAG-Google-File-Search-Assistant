# =============================================================================
# Python Backend Environment Configuration
# =============================================================================

# Application environment ('development' for local pairing, 'production' for deployment)
APP_ENV=development

# Google Gemini API credentials (required for File Search ingestion and queries)
GEMINI_API_KEY=your_gemini_api_key_here
# Must be set to a Gemini model supported by your API key that supports File Search
# (check available models in your Google AI Studio account)
GEMINI_MODEL=
# Optional: File Search store display name / explicit store resource name (e.g., fileSearchStores/abc123)
FILE_SEARCH_STORE_DISPLAY_NAME=personal-ai-knowledge-assistant
FILE_SEARCH_STORE_NAME=

# Gemini API timeout in seconds (defaults to 120 seconds if unset)
GEMINI_TIMEOUT_SECONDS=120

# Demonstration Bearer token required for backend access
# In development, leave empty for open local access. In production, this is required.
DEMO_ACCESS_TOKEN=

# Reviewer Access Token for Streamlit interface demo access unlock
REVIEWER_ACCESS_TOKEN=

# Contact destination for requesting demo access (email or URL)
CONTACT_EMAIL=
CONTACT_URL=

# Allowed frontend origins (exact matches, comma-separated, no wildcards)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Proxy header trust (false by default to prevent spoofed X-Forwarded-For headers)
TRUST_PROXY_HEADERS=false

# Network binding
HOST=127.0.0.1
PORT=8000

# Document Paths (for direct deployment or containers)
DOCUMENTS_DIRECTORY=./data/documents

# Operational Limits
MAX_CONCURRENT_QUERIES=3
RATE_LIMIT_PER_MINUTE=15